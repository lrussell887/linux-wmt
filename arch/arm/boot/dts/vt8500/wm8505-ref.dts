/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include "wm8505.dtsi"

/ {
	model = "WonderMedia WM8505 Netbook";
	compatible = "wm,wm8505-ref", "wm,wm8505";

	vcc33: regulator-vcc33 {
		compatible = "regulator-fixed";
		regulator-name = "vcc33";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
	};

	backlight: backlight {
		compatible = "pwm-backlight";
		brightness-levels = <0>, <40>, <42>, <46>, <52>, <60>,
				    <70>, <81>, <95>, <109>, <126>, <144>,
				    <163>, <184>, <206>, <230>, <255>;
		default-brightness-level = <11>;
		pwms = <&pwm 0 150000>;
	};

	panel {
		compatible = "innolux,at070tn92";
		power-supply = <&vcc33>;
		backlight = <&backlight>;

		port {
			panel_in: endpoint {
				remote-endpoint = <&display_out>;
			};
		};
	};
};

&ac97 {
	speaker-gpios = <&pinctrl 3 GPIO_ACTIVE_LOW>;
	status = "okay";
};

&display {
	status = "okay";

	port {
		display_out: endpoint {
			remote-endpoint = <&panel_in>;
		};
	};
};

&pwm {
	status = "okay";
};

&uart0 {
	status = "okay";
};
